---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import themeScript from '../scripts/theme.js?raw';
interface Props {
  title: string;
  description?: string;
  article?: boolean;
}
const {
  title,
  description = 'Rohit Udaiwal — AI engineer at Risa Labs. Building knowledge graphs, voice agents, and systems for healthcare.',
  article = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f5ef" />
    <script is:inline id="portfolio-theme" set:html={themeScript} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="google-site-verification"
      content="e4T7uh-uF1kHv0-RNXoYKN-9CLNXEgJIDRY25emmntQ"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={new URL('/assets/social.png', Astro.site)}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="site-shell">
      <SiteHeader />
      <main id="main">
        <slot />
      </main>
    </div>
  </body>
</html>
