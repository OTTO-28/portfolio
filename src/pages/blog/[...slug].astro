---
import { render } from 'astro:content';
import { getPosts, getArtwork, type Post } from '../../lib/posts';
interface Props {
  post: Post;
}
import Layout from '../../layouts/Layout.astro';
import Artwork from '../../components/Artwork.astro';
export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const posts = await getPosts();
const other =
  posts[(posts.findIndex((p) => p.id === post.id) + 1) % posts.length];
---

<Layout
  title={`${post.data.title} — Rohit Udaiwal`}
  description={post.data.description}
  article
>
  <article class="article">
    <a class="back-link" href="/blog/">
      ← All field notes
    </a>
    <header class="article-header">
      <div class="eyebrow">{post.data.category} / Field notes</div>
      <h1>{post.data.title}</h1>
      <p class="article-deck">{post.data.description}</p>
      <div class="article-meta">
        Rohit Udaiwal ·{' '}
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
            timeZone: 'UTC',
          })}
        </time>{' '}
        · {post.data.readTime} min read
      </div>
    </header>
    <div class:list={['post-art', post.data.category === 'Music' && 'music']}>
      <Artwork type={getArtwork(post)} />
    </div>
    <div class="prose">
      <Content />
    </div>
    <div class="article-end">
      <a href="/blog/">← Back to field notes</a>
      {other && <a href={`/blog/${other.id}/`}>Next: {other.data.title} ↗</a>}
    </div>
  </article>
</Layout>
