---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';
const posts = await getPosts();
---

<Layout
  title="Blogs & field notes — Rohit Udaiwal"
  description="Essays on voice AI engineering, knowledge graphs for clinical-trial screening, and the intuition behind music theory."
>
  <header class="blog-header">
    <div class="eyebrow">The blog / Systems, sounds & rabbit holes</div>
    <h1>Field notes.</h1>
    <p>
      Things I’m building, ideas I’m untangling, and the occasional detour into
      why a few notes sound so good together.
    </p>
  </header>
  <section class="blog-list" aria-label="All blog posts">
    <div class="section-heading">
      <span class="small-label">{posts.length} stories to explore</span>
    </div>
    <div class="writing-grid">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</Layout>
